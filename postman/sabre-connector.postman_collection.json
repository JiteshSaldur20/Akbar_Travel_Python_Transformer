								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"originCode\": \"BOM\",\n  \"destinationCode\": \"DEL\",\n  \"departureDate\": \"2026-11-06\",\n  \"passengers\": [{ \"passengerType\": \"ADT\", \"count\": 1 }]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/transform/nope",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"transform",
								"nope"
							]
						},
						"description": "Unknown provider. The body names the providers this connector does know."
					},
					"response": []
				},
				{
					"name": "Response that is not a BFM body (expect 422)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"data\": {\n    \"results\": []\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/transform/sabre/response",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"transform",
								"sabre",
								"response"
							]
						},
						"description": "The transform refuses a payload that is not a groupedItineraryResponse instead of reporting 'no flights', so a wrong response can never be mistaken for an empty result set. A BFM body with an EMPTY itineraryGroups array is a valid 'no flights' answer and returns 200 with results: []."
					},
					"response": []
				}
			]
		}
	]
}
