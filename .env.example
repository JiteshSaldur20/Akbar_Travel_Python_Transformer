# --- Service ---
SERVICE_NAME=sabre-transformer
SERVICE_PORT=8090

# --- Search tuning (shapes the BFM request; NOT credentials) ---
SEARCH_NUMBER_OF_TRIPS=10
SEARCH_MAX_CONNECTIONS=4
SEARCH_FARES_PER_JOURNEY=4
SEARCH_PREFER_NDC_ON_TIE=true
SEARCH_ENABLE_ATPCO=true
SEARCH_ENABLE_NDC=false
SEARCH_MAX_UPSELLS=0
SEARCH_MULTIPLE_BRANDED_FARES=false

# NOTE: Sabre username/password/PCC, token URLs, and any provider
# endpoints are intentionally NOT configured here. This service never
# contacts Sabre; Java owns provider communication and authentication.
