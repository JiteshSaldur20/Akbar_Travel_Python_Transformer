# Java ORBiS Internal Service URL (owns provider authentication, credentials, and token caching)
JAVA_INTERNAL_URL=http://localhost:8080
JAVA_CONNECT_TIMEOUT_S=5.0
JAVA_READ_TIMEOUT_S=10.0

# Sabre Provider Endpoint Configuration (No secrets stored in Python)
SABRE_BASE_URL=https://api.cert.platform.sabre.com
SABRE_SEARCH_PATH=v5/offers/shop
SABRE_CONNECT_TIMEOUT_S=10.0
SABRE_READ_TIMEOUT_S=30.0

# Sabre BFM data source toggles
SEARCH_ENABLE_ATPCO=true
SEARCH_ENABLE_NDC=false